{
  "extends": ["next/core-web-vitals", "next/typescript"],
  "plugins": ["jsx-a11y"],
  "rules": {
    // Enforce accessibility on all JSX elements
    "jsx-a11y/alt-text": "error",
    "jsx-a11y/anchor-has-content": "error",
    "jsx-a11y/aria-props": "error",
    "jsx-a11y/aria-proptypes": "error",
    "jsx-a11y/aria-unsupported-elements": "error",
    "jsx-a11y/role-has-required-aria-props": "error",
    "jsx-a11y/role-supports-aria-props": "error",
    "jsx-a11y/interactive-supports-focus": "error",
    "jsx-a11y/click-events-have-key-events": "error",
    "jsx-a11y/no-noninteractive-element-interactions": "warn",
    // No unused imports / variables
    "@typescript-eslint/no-unused-vars": [
      "error",
      { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_" }
    ],
    // Enforce explicit return types on functions
    "@typescript-eslint/explicit-function-return-type": "off",
    "@typescript-eslint/explicit-module-boundary-types": "off",
    // Prefer const
    "prefer-const": "error",
    // No console logs in production (warn in dev)
    "no-console": ["warn", { "allow": ["warn", "error"] }],
    // Enforce Next.js image component
    "@next/next/no-img-element": "error",
    // No hardcoded localhost
    "no-restricted-globals": [
      "error",
      { "name": "localStorage", "message": "Never store auth tokens in localStorage." },
      { "name": "sessionStorage", "message": "Never store auth tokens in sessionStorage." }
    ]
  }
}
