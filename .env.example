# ============================================================
# KANGANHERI DARPAN — Environment Variables
# ============================================================
# Copy this file to `.env.local` and fill in all values.
# NEVER commit .env.local to version control.
# Production secrets must be stored in a secrets manager
# (e.g., Vercel env, Doppler, AWS Secrets Manager).
# ============================================================

# ── Application ─────────────────────────────────────────────
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Kanganheri Darpan"
NEXT_PUBLIC_VILLAGE_NAME="Kanganheri"
NEXT_PUBLIC_VILLAGE_PIN="110071"

# The canonical production URL (used for CSP, CORS, sitemaps, canonical tags)
ALLOWED_ORIGINS=https://kanganheri.com

# ── Database (PostgreSQL) ────────────────────────────────────
# Connection pooler URL (PgBouncer / Supabase Supavisor)
# Used by Prisma at runtime
DATABASE_URL="postgresql://kanganheri_app:CHANGE_ME@localhost:6432/kanganheri_db?pgbouncer=true&connection_limit=10&sslmode=require"

# Direct URL (bypasses pooler) — used ONLY for Prisma migrations
DIRECT_URL="postgresql://kanganheri_app:CHANGE_ME@localhost:5432/kanganheri_db?sslmode=require"

# ── Redis (Upstash or local) ─────────────────────────────────
# For Upstash: obtain from https://upstash.com/
UPSTASH_REDIS_REST_URL="https://your-redis.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-token"

# For local Redis (docker-compose), use the ioredis connection string:
REDIS_URL="redis://localhost:6379"

# ── Authentication (JWT) ─────────────────────────────────────
# Generate with: openssl rand -base64 64
JWT_ACCESS_SECRET="CHANGE_ME_generate_64_char_random_secret_for_access_tokens"
JWT_REFRESH_SECRET="CHANGE_ME_generate_64_char_different_secret_for_refresh_tokens"

# Token lifetimes
JWT_ACCESS_EXPIRY_SECONDS=900        # 15 minutes
JWT_REFRESH_EXPIRY_SECONDS=2592000   # 30 days

# ── IP Hashing Salt ─────────────────────────────────────────
# Daily-rotating salt for hashing IP addresses (DPDP compliance)
# In production, rotate daily via a cron that updates this secret
IP_HASH_SALT="CHANGE_ME_rotate_daily_random_salt_for_ip_hashing"

# ── Content Security Policy ──────────────────────────────────
# Script sources allowed in CSP (space-separated, beyond 'self' + nonce)
CSP_EXTRA_SCRIPT_SRC=""
# Style sources allowed in CSP
CSP_EXTRA_STYLE_SRC=""

# ── Cloudflare Turnstile (CAPTCHA) ──────────────────────────
# Public site key (safe to expose in frontend)
NEXT_PUBLIC_TURNSTILE_SITE_KEY="your-cloudflare-turnstile-site-key"
# Secret key (server-side only)
TURNSTILE_SECRET_KEY="your-cloudflare-turnstile-secret-key"

# ── File Uploads ─────────────────────────────────────────────
# Maximum file size in bytes (default 5MB per photo)
MAX_UPLOAD_SIZE_BYTES=5242880
# Allowed MIME types for complaint photo uploads
ALLOWED_UPLOAD_MIME_TYPES="image/jpeg,image/png,image/webp,image/heic"
# Upload storage path (local dev) or object storage bucket
UPLOAD_LOCAL_PATH="./public/uploads"

# Object storage for production (Cloudflare R2 / AWS S3 compatible)
S3_ENDPOINT="https://your-account.r2.cloudflarestorage.com"
S3_ACCESS_KEY_ID="your-access-key"
S3_SECRET_ACCESS_KEY="your-secret-key"
S3_BUCKET_NAME="kanganheri-media"
S3_REGION="auto"
S3_PUBLIC_CDN_URL="https://cdn.kanganheri.com"

# ── Open-Meteo (Weather API) ────────────────────────────────
# Open-Meteo is free/open — no API key required for basic use.
# This is the public API base URL (override for enterprise plans).
OPEN_METEO_API_BASE="https://api.open-meteo.com/v1"

# Kanganheri village coordinates (for weather API)
NEXT_PUBLIC_VILLAGE_LAT="28.5468"
NEXT_PUBLIC_VILLAGE_LON="76.9883"

# ── Sentry (Error Tracking) ──────────────────────────────────
SENTRY_DSN="https://your-sentry-dsn@sentry.io/project-id"
NEXT_PUBLIC_SENTRY_DSN="https://your-sentry-dsn@sentry.io/project-id"
SENTRY_ORG="your-sentry-org"
SENTRY_PROJECT="kanganheri-darpan"
# Generate at: https://sentry.io/settings/account/api/auth-tokens/
SENTRY_AUTH_TOKEN="your-sentry-auth-token"

# ── Monitoring Alerts ────────────────────────────────────────
# Telegram bot token + chat ID for 5xx / healthcheck alerts
TELEGRAM_BOT_TOKEN="your-telegram-bot-token"
TELEGRAM_ALERT_CHAT_ID="your-telegram-chat-id"

# Discord webhook URL for alerts (optional)
DISCORD_WEBHOOK_URL="https://discord.com/api/webhooks/your-webhook"

# ── Database Backup (DR) ─────────────────────────────────────
# Used by scripts/backup-db.sh for encrypted daily dumps
DB_BACKUP_ENCRYPTION_KEY="CHANGE_ME_32_char_AES256_backup_key"
BACKUP_S3_BUCKET="kanganheri-backups"
BACKUP_S3_PREFIX="pg-dumps"
# Retention: 7 daily, 4 weekly
BACKUP_DAILY_RETENTION=7
BACKUP_WEEKLY_RETENTION=4

# ── Rate Limiting ────────────────────────────────────────────
# Complaint submissions per hour per IP
RATE_LIMIT_COMPLAINTS_PER_HOUR=5
# General API reads per minute per IP
RATE_LIMIT_API_READS_PER_MINUTE=60
# Admin login attempts per 15 minutes per IP
RATE_LIMIT_ADMIN_LOGIN_PER_15MIN=5

# ── Idempotency ──────────────────────────────────────────────
# TTL in seconds for idempotency keys in Redis (24 hours)
IDEMPOTENCY_KEY_TTL_SECONDS=86400

# ── i18n ────────────────────────────────────────────────────
# Default locale for the site
NEXT_PUBLIC_DEFAULT_LOCALE=hi
